---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StarRating from '../../components/StarRating.astro';
import DiamondRating from '../../components/DiamondRating.astro';
import DinnerMap from '../../components/DinnerMap.astro';
import dinnersData from '../../data/dinners.json';
import { RATING_PROVIDER } from '../../data/config.ts';

type DinnerEntry = {
  slug: string;
  name: string;
  date: string;
  cuisine: string;
  neighborhood: string;
  lat: number;
  lng: number;
  price_range: number;
  external_rating: number;
  our_rating?: number | null;
  notes?: string;
  website?: string;
  photos: string[];
  published?: boolean;
};

export async function getStaticPaths() {
  const entries = await getCollection('dinners');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = {
  entry: Awaited<ReturnType<typeof getCollection<'dinners'>>>[0];
};

const { entry } = Astro.props;
const { Content } = await render(entry);

const dinner = (dinnersData as DinnerEntry[]).find(d => d.slug === entry.id);
if (!dinner) throw new Error(`No dinner data found for slug: ${entry.id}`);

const fmtDate = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

const priceStr = '$'.repeat(dinner.price_range);

const description = dinner.notes
  ? `${dinner.name} (${dinner.neighborhood}): ${dinner.notes}`
  : `Our review of ${dinner.name}, a ${dinner.cuisine} restaurant in ${dinner.neighborhood}.`;

const pageURL = new URL(`/dinners/${dinner.slug}/`, Astro.site).href;
const ogImage = dinner.photos?.[0] ? new URL(dinner.photos[0].src, Astro.site).href : undefined;

const reviewRating = dinner.our_rating ?? dinner.external_rating;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  name: `${dinner.name} Review`,
  itemReviewed: {
    '@type': 'Restaurant',
    name: dinner.name,
    servesCuisine: dinner.cuisine,
    address: {
      '@type': 'PostalAddress',
      addressLocality: dinner.neighborhood,
      addressRegion: 'CA',
    },
    ...(dinner.lat && dinner.lng
      ? { geo: { '@type': 'GeoCoordinates', latitude: dinner.lat, longitude: dinner.lng } }
      : {}),
    ...(dinner.website ? { url: dinner.website } : {}),
    priceRange: '$'.repeat(dinner.price_range),
  },
  reviewRating: {
    '@type': 'Rating',
    ratingValue: reviewRating,
    bestRating: 5,
  },
  author: {
    '@type': 'Organization',
    name: 'Super Fancy Supper Club',
    url: 'https://superfancysupperclub.com',
  },
  datePublished: dinner.date,
  url: pageURL,
};
---

<Base title={`${dinner.name} · Super Fancy Supper Club`} description={description} image={ogImage} activeNav="past-dinners">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <main>
    <nav class="breadcrumb">
      <a href="/past-dinners" class="back-link">← Past Dinners</a>
    </nav>

    <header class="dinner-header">
      <time class="dinner-date" datetime={dinner.date}>{fmtDate(dinner.date)}</time>
      <div class="dinner-name-row">
        <h1 class="dinner-name">{dinner.name}</h1>
        {dinner.website && (
          <a href={dinner.website} target="_blank" rel="noopener" class="website-icon" title={`Visit ${dinner.name} website`} aria-label={`${dinner.name} website (opens in new tab)`}>↗</a>
        )}
      </div>
      <div class="dinner-meta">
        <span>{dinner.cuisine}</span>
        <span class="sep">·</span>
        <span>{dinner.neighborhood}</span>
        <span class="sep">·</span>
        <span class="ratings">
          <span class="price" title={`Price range: ${dinner.price_range} of 4`}>{priceStr}</span>
          <span class="sep">·</span>
          <span class="rating-item" title=`${RATING_PROVIDER} rating: ${dinner.external_rating}`>
            <span class="rating-label">{RATING_PROVIDER}</span>
            <StarRating rating={dinner.external_rating} size={13} label={RATING_PROVIDER} />
          </span>
          {dinner.our_rating != null && (
            <>
              <span class="sep">·</span>
              <span class="rating-item" title={`Our rating: ${dinner.our_rating}`}>
                <span class="rating-label">Ours</span>
                <DiamondRating rating={dinner.our_rating} size={13} label="Our Rating" />
              </span>
            </>
          )}
        </span>
      </div>
    </header>


    <div class="dinner-body">
      <Content />
    </div>

    {entry.data.highlights && entry.data.highlights.length > 0 && (
      <section class="dinner-section">
        <hr class="brass-rule" />
        <h2 class="section-title">HIGHLIGHTS</h2>
        <ul class="item-list">
          {entry.data.highlights.map((h: string) => <li>{h}</li>)}
        </ul>
      </section>
    )}

    {entry.data.dishes && entry.data.dishes.length > 0 && (
      <section class="dinner-section">
        <hr class="brass-rule" />
        <h2 class="section-title">STANDOUT DISHES</h2>
        <ul class="item-list">
          {entry.data.dishes.map((d: string) => <li>{d}</li>)}
        </ul>
      </section>
    )}

    {entry.data.tips && entry.data.tips.length > 0 && (
      <section class="dinner-section">
        <hr class="brass-rule" />
        <h2 class="section-title">PRO TIPS</h2>
        <ul class="item-list">
          {entry.data.tips.map((t: string) => <li>{t}</li>)}
        </ul>
      </section>
    )}

    {dinner.photos && dinner.photos.length > 0 && (
      <section class="gallery-section">
        <hr class="brass-rule" />
        <h2 class="section-title">PHOTOS</h2>
        <div class="gallery" id="photo-gallery" data-photos={JSON.stringify(dinner.photos)} data-name={dinner.name}>
          {dinner.photos.map((photo, i) => (
            <button class="gallery-item" data-index={i} aria-label={`Open photo ${i + 1} of ${dinner.photos.length}`}>
              <img src={photo.src} alt={`${photo.caption} at ${dinner.name}`} loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      </section>
    )}

    <div id="lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
      <div class="lightbox-backdrop"></div>
      <button class="lightbox-close" aria-label="Close photo viewer">✕</button>
      <div class="lightbox-details lightbox-caption" id="lightbox-caption"></div>
      <div class="lightbox-mid">
        <button class="lightbox-nav lightbox-prev" aria-label="Previous photo">&#8249;</button>
        <div class="lightbox-stage">
          <img id="lightbox-img" src="" alt="" />
        </div>
        <button class="lightbox-nav lightbox-next" aria-label="Next photo">&#8250;</button>
      </div>
      <div class="lightbox-details lightbox-counter" id="lightbox-counter"></div>
    </div>

    {dinner.lat && dinner.lng && (
      <hr class="brass-rule" />
      <div class="map-section">
        <DinnerMap name={dinner.name} lat={dinner.lat} lng={dinner.lng} neighborhood={dinner.neighborhood} />
      </div>
    )}
  </main>
</Base>

<style>
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .breadcrumb {
    margin-bottom: clamp(20px, 3vh, 36px);
  }
  .back-link {
    font-family: var(--serif-display);
    font-size: clamp(9px, 0.95vw, 11px);
    letter-spacing: 0.38em;
    color: var(--brass-lo);
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.15s;
  }
  .back-link:hover { color: var(--brass); }

  .dinner-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: clamp(24px, 3.5vh, 40px);
  }
  .dinner-date {
    font-family: var(--serif-display);
    font-size: clamp(9px, 0.95vw, 11px);
    letter-spacing: 0.38em;
    color: var(--brass-lo);
    text-transform: uppercase;
  }
  .dinner-name-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .dinner-name {
    margin: 0;
    font-family: var(--serif-display);
    font-weight: 500;
    font-size: clamp(28px, 4.5vw, 56px);
    letter-spacing: 0.06em;
    color: var(--brass-hi);
    line-height: 1.05;
  }
  .website-icon {
    font-family: var(--serif-body);
    font-size: clamp(16px, 2vw, 22px);
    color: var(--brass-lo);
    text-decoration: none;
    transition: color 0.15s;
    flex-shrink: 0;
  }
  .website-icon:hover { color: var(--brass); }

  .dinner-meta {
    font-family: var(--serif-body);
    font-size: clamp(15px, 1.5vw, 18px);
    color: var(--brass);
    letter-spacing: 0.04em;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .sep { margin: 0 0.5em; color: var(--brass-faint); }
  .price { letter-spacing: 0.08em; }
  .rating-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .rating-label {
    font-family: var(--serif-display);
    font-size: clamp(8px, 0.85vw, 10px);
    letter-spacing: 0.3em;
    color: var(--brass-lo);
    text-transform: uppercase;
  }

  .gallery-section {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.5vh, 18px);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 10px;
  }
  .gallery-item {
    display: block;
    overflow: hidden;
    border: 1px solid var(--brass-faint);
    aspect-ratio: 4 / 3;
    transition: border-color 0.15s;
    padding: 0;
    background: none;
    cursor: pointer;
  }
  .gallery-item:hover { border-color: var(--brass-lo); }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.15s;
  }
  .gallery-item:hover img { opacity: 0.88; }

  /* ── Lightbox ──────────────────────────────────────────────── */
  /* The close icon, caption, and counter sit in their own flex rows
     above/below the image, and the nav arrows are flex siblings of
     the image itself — so they always hug the photo's actual edges
     instead of being stranded at the screen edges, while never
     overlapping it, at any image size or browser zoom level. */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(10px, 1.5vh, 18px);
    padding: clamp(48px, 7vh, 72px) clamp(20px, 4vw, 48px) clamp(28px, 5vh, 48px);
  }
  .lightbox[hidden] { display: none; }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 24, 18, 0.95);
    cursor: pointer;
  }

  .lightbox-mid {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(10px, 2.5vw, 28px);
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
  }

  .lightbox-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
  }

  #lightbox-img {
    display: block;
    max-width: min(80vw, 1400px);
    max-height: min(76vh, 900px);
    object-fit: contain;
    border: 1px solid var(--brass-faint);
    box-shadow: 0 0 60px rgba(0,0,0,0.7);
    user-select: none;
    -webkit-user-drag: none;
  }

  .lightbox-close {
    position: absolute;
    top: clamp(12px, 2vh, 22px);
    right: clamp(12px, 2vw, 26px);
    z-index: 3;
    background: none;
    border: none;
    color: var(--brass);
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1;
    padding: 10px 14px;
    cursor: pointer;
    transition: color 0.15s;
    font-family: var(--serif-body);
  }
  .lightbox-close:hover { color: var(--brass-hi); }

  .lightbox-nav {
    position: relative;
    z-index: 2;
    flex: 0 0 auto;
    background: none;
    border: none;
    color: var(--brass);
    font-size: clamp(32px, 4.5vw, 60px);
    line-height: 1;
    padding: 10px 6px;
    cursor: pointer;
    transition: color 0.15s;
    font-family: var(--serif-body);
    user-select: none;
  }
  .lightbox-nav:hover { color: var(--brass-hi); }
  .lightbox-nav[hidden] { display: none; }

  .lightbox-details {
    position: relative;
    z-index: 2;
    flex: 0 0 auto;
    font-family: var(--serif-display);
    font-size: clamp(11px, 1.2vw, 14px);
    letter-spacing: 0.28em;
    color: var(--brass);
    text-transform: uppercase;
    text-align: center;
    max-width: min(80vw, 700px);
  }

  .lightbox-counter {
    white-space: nowrap;
  }

  .map-section {
    margin-top: clamp(20px, 3vh, 40px);
    z-index: 0;
  }

  .dinner-body {
    font-family: var(--serif-body);
    font-size: clamp(16px, 1.65vw, 19px);
    color: var(--brass-hi);
    line-height: 1.7;
    max-width: 72ch;
    margin-bottom: clamp(16px, 2.5vh, 28px);
  }
  .dinner-body :global(p) {
    margin: 0 0 1.2em;
  }
  .dinner-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .dinner-section {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.5vh, 18px);
  }
  .section-title {
    margin: 0;
    font-family: var(--serif-display);
    font-size: clamp(10px, 1.1vw, 13px);
    letter-spacing: 0.4em;
    color: var(--brass-lo);
    font-weight: 400;
    padding-left: 0.4em;
  }
  .item-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 68ch;
  }
  .item-list li {
    font-family: var(--serif-body);
    font-size: clamp(15px, 1.55vw, 18px);
    color: var(--brass);
    line-height: 1.5;
    padding-left: 1.2em;
    position: relative;
  }
  .item-list li::before {
    content: '◆';
    position: absolute;
    left: 0;
    font-size: 0.55em;
    top: 0.35em;
    color: var(--brass-lo);
  }
</style>

<script>
  const gallery = document.getElementById('photo-gallery');
  if (gallery) {
    const photos: string[] = JSON.parse(gallery.dataset.photos || '[]');
    const name: string = gallery.dataset.name || '';
    const lightbox = document.getElementById('lightbox') as HTMLElement;
    const img = document.getElementById('lightbox-img') as HTMLImageElement;
    const caption = document.getElementById('lightbox-caption') as HTMLElement;
    const counter = document.getElementById('lightbox-counter') as HTMLElement;
    const prevBtn = lightbox.querySelector('.lightbox-prev') as HTMLButtonElement;
    const nextBtn = lightbox.querySelector('.lightbox-next') as HTMLButtonElement;
    const closeBtn = lightbox.querySelector('.lightbox-close') as HTMLButtonElement;
    const backdrop = lightbox.querySelector('.lightbox-backdrop') as HTMLElement;

    let current = 0;

    function show(index: number) {
      current = (index + photos.length) % photos.length;
      img.src = photos[current].src;
      img.alt = photos[current].caption;
      caption.textContent = photos[current].caption
      counter.textContent = `${current + 1} / ${photos.length}`;
      prevBtn.hidden = photos.length <= 1;
      nextBtn.hidden = photos.length <= 1;
    }

    function open(index: number) {
      show(index);
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function close() {
      lightbox.hidden = true;
      document.body.style.overflow = '';
    }

    gallery.querySelectorAll<HTMLButtonElement>('.gallery-item').forEach(btn => {
      btn.addEventListener('click', () => open(Number(btn.dataset.index)));
    });

    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));
    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // Touch swipe
    let touchStartX = 0;
    lightbox.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });
    lightbox.addEventListener('touchend', (e: TouchEvent) => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 40) show(dx < 0 ? current + 1 : current - 1);
    }, { passive: true });
  }
</script>
