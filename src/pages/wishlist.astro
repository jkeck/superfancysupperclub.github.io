---
import Base from '../layouts/Base.astro';
import WishlistClient from '../components/WishlistClient.astro';
import wishlist from '../data/wishlist.json';
import dinners from '../data/dinners.json';

// Filter out restaurants already visited
const visitedSlugs = new Set(dinners.map(d => d.slug));
// Also match by name (case-insensitive) for items without explicit slug overlap
const visitedNames = new Set(dinners.map(d => d.name.toLowerCase()));
const available = wishlist.filter(
  item => !visitedSlugs.has(item.slug) && !visitedNames.has(item.name.toLowerCase())
);
---

<Base title="Wishlist · Super Fancy Supper Club" activeNav="wishlist">
  <main>
    <header class="page-header">
      <h1 class="page-title">THE WISHLIST</h1>
      <p class="page-subtitle">
        {available.length} {available.length === 1 ? 'candidate' : 'candidates'} awaiting their moment.
        Add to the list, then draw the lot.
      </p>
    </header>

    <WishlistClient baseList={available} />
  </main>
</Base>

<style>
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .page-header {
    margin-bottom: clamp(24px, 3.5vh, 40px);
  }
  .page-title {
    margin: 0 0 8px;
    font-family: var(--serif-display);
    font-size: clamp(22px, 3.5vw, 40px);
    letter-spacing: 0.14em;
    color: var(--brass-hi);
    font-weight: 600;
  }
  .page-subtitle {
    margin: 0;
    font-style: italic;
    font-size: clamp(15px, 1.5vw, 18px);
    color: var(--brass-lo);
    max-width: 60ch;
  }
</style>
