---
import { diamondRatingHTML } from '../lib/diamondRating';

interface Props {
  rating: number;
  max?: number;
  size?: number;
  label?: string;
}

const { rating, max = 5, size = 14, label = 'Rating' } = Astro.props;
const html = diamondRatingHTML(rating, { max, size, label });
---

<Fragment set:html={html} />

<style>
  .diamond-rating {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    line-height: 1;
    vertical-align: middle;
  }
</style>
