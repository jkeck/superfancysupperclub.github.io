---
import StarRating from './StarRating.astro';
import { RATING_PROVIDER } from '../data/config.ts';

interface WishlistItem {
  slug: string;
  name: string;
  cuisine: string;
  neighborhood: string;
  price_range: number;
  external_rating?: number | null;
  added_by?: string;
  notes?: string;
  website?: string;
  closed_days?: number[];
  session?: boolean;
}

interface Props {
  baseList: WishlistItem[];
}

const { baseList } = Astro.props;

const DAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
---

<div class="wishlist-root">

  <!-- Controls -->
  <div class="wishlist-controls">
    <form id="add-form" class="add-form" autocomplete="off">
      <input id="add-name" type="text" placeholder="Add a restaurant…" class="add-input" maxlength="80" />
      <input id="add-cuisine" type="text" placeholder="Cuisine (optional)" class="add-input add-input--sm" maxlength="40" />
      <input id="add-hood" type="text" placeholder="Neighborhood (optional)" class="add-input add-input--sm" maxlength="40" />
      <button type="submit" class="add-btn">ADD</button>
    </form>
  </div>

  <div class="wishlist-controls lot-draw">
    <div class="date-filter">
      <label for="filter-date" class="date-filter-label">RESERVATION DATE</label>
      <input id="filter-date" type="date" class="date-input" />
      <span id="filter-status" class="filter-status" hidden></span>
    </div>
    <button id="draw-btn" class="draw-btn" disabled>DRAW THE LOT</button>
  </div>

  <!-- Card list — server-rendered base, client appends session items -->
  <div id="wishlist-cards" class="wishlist-cards">
    {baseList.map(item => (
      <article
        class="wish-card"
        data-name={item.name}
        data-closed-days={JSON.stringify(item.closed_days ?? [])}
      >
        <div class="wish-card-header">
          <h2 class="wish-name">
            {item.website
              ? <a href={item.website} target="_blank" rel="noopener" class="wish-name-link">{item.name}</a>
              : item.name}
          </h2>
          <div class="wish-card-end">
            {item.external_rating != null && (
              <span class="wish-rating" title={`${RATING_PROVIDER} rating: ${item.external_rating}`}>
                <StarRating rating={item.external_rating} size={11} label={RATING_PROVIDER} />
              </span>
            )}
            <span class="wish-price" title={`Price range: ${item.price_range} of 4`}>{'$'.repeat(item.price_range)}</span>
          </div>
        </div>
        <div class="wish-meta">
          {item.cuisine && <span>{item.cuisine}</span>}
          {item.cuisine && item.neighborhood && <span class="sep">·</span>}
          {item.neighborhood && <span>{item.neighborhood}</span>}
          {item.added_by && <><span class="sep">·</span><span class="wish-added">added by {item.added_by}</span></>}
        </div>
        {item.notes && <p class="wish-notes">{item.notes}</p>}
        <div class="wish-card-footer">
          <button class="wish-remove-btn" type="button" aria-label="Remove from draw">REMOVE</button>
        </div>
      </article>
    ))}
  </div>

  <!-- Picker modal -->
  <div id="picker-modal" class="picker-modal" role="dialog" aria-modal="true" aria-label="Restaurant draw" hidden>
    <div class="picker-inner">
      <div class="picker-eyebrow">THE DRAW</div>
      <div id="picker-display" class="picker-display" aria-live="polite">—</div>
      <div class="picker-actions">
        <button id="draw-again-btn" class="picker-btn picker-btn--secondary">DRAW AGAIN</button>
        <button id="close-modal-btn" class="picker-btn picker-btn--primary">CLOSE</button>
      </div>
    </div>
  </div>

</div>

<script>
  const cardsEl    = document.getElementById('wishlist-cards')!;
  const modal      = document.getElementById('picker-modal')!;
  const display    = document.getElementById('picker-display')!;
  const drawBtn    = document.getElementById('draw-btn') as HTMLButtonElement;
  const addForm    = document.getElementById('add-form') as HTMLFormElement;
  const nameInput  = document.getElementById('add-name') as HTMLInputElement;
  const cuisineInput = document.getElementById('add-cuisine') as HTMLInputElement;
  const hoodInput  = document.getElementById('add-hood') as HTMLInputElement;
  const filterDate = document.getElementById('filter-date') as HTMLInputElement;
  const filterStatus = document.getElementById('filter-status') as HTMLElement;

  const DAY_NAMES = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];

  // Cards in draw pool: not removed, not date-filtered
  function getActiveCards(): HTMLElement[] {
    return Array.from(document.querySelectorAll<HTMLElement>('#wishlist-cards .wish-card'))
      .filter(el => el.dataset.removed !== 'true' && el.dataset.filtered !== 'true');
  }

  function getNames(): string[] {
    return getActiveCards().map(el => el.dataset.name ?? '').filter(Boolean);
  }

  function syncDrawBtn() {
    drawBtn.disabled = getNames().length === 0;
  }

  // --- Date filter ---
  function applyDateFilter() {
    const value = filterDate.value;
    if (!value) {
      document.querySelectorAll<HTMLElement>('#wishlist-cards .wish-card').forEach(card => {
        delete card.dataset.filtered;
      });
      filterStatus.hidden = true;
      filterStatus.textContent = '';
    } else {
      // Parse as local date to avoid timezone shifting the day-of-week
      const [y, m, d] = value.split('-').map(Number);
      const targetDay = new Date(y, m - 1, d).getDay();
      let closedCount = 0;
      let totalBase = 0;

      document.querySelectorAll<HTMLElement>('#wishlist-cards .wish-card:not(.wish-card--session)').forEach(card => {
        totalBase++;
        let closedDays: number[] = [];
        try { closedDays = JSON.parse(card.dataset.closedDays ?? '[]'); } catch {}
        if (closedDays.includes(targetDay)) {
          card.dataset.filtered = 'true';
          closedCount++;
        } else {
          delete card.dataset.filtered;
        }
      });

      const openCount = totalBase - closedCount;
      if (closedCount > 0) {
        filterStatus.textContent = `${openCount} open`;
        filterStatus.hidden = false;
      } else {
        filterStatus.textContent = `All open`;
        filterStatus.hidden = false;
      }
    }
    syncDrawBtn();
  }

  filterDate.addEventListener('change', applyDateFilter);

  // --- Remove toggle ---
  cardsEl.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLElement>('.wish-remove-btn');
    if (!btn) return;
    const card = btn.closest<HTMLElement>('.wish-card');
    if (!card) return;
    const isRemoved = card.dataset.removed === 'true';
    card.dataset.removed = isRemoved ? 'false' : 'true';
    btn.textContent = isRemoved ? 'REMOVE' : 'RESTORE';
    syncDrawBtn();
  });

  syncDrawBtn();

  // --- Add form ---
  addForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = nameInput.value.trim();
    if (!name) return;
    const cuisine = cuisineInput.value.trim();
    const hood = hoodInput.value.trim();

    const card = document.createElement('article');
    card.className = 'wish-card wish-card--session';
    card.dataset.name = name;
    card.dataset.closedDays = '[]';
    card.innerHTML = `
      <div class="wish-card-header">
        <h2 class="wish-name">${escHtml(name)}</h2>
        <span class="wish-session-badge">THIS SESSION</span>
      </div>
      ${cuisine || hood ? `<div class="wish-meta">${[cuisine, hood].filter(Boolean).map(escHtml).join('<span class="sep">·</span>')}</div>` : ''}
      <div class="wish-card-footer">
        <button class="wish-remove-btn" type="button">REMOVE</button>
      </div>
    `;
    cardsEl.appendChild(card);
    nameInput.value = '';
    cuisineInput.value = '';
    hoodInput.value = '';
    nameInput.focus();
    syncDrawBtn();
  });

  // --- Picker ---
  let animFrame = 0;

  function runDraw() {
    const names = getNames();
    if (!names.length) return;

    modal.hidden = false;
    document.getElementById('draw-again-btn')!.style.display = 'none';

    const winner = names[Math.floor(Math.random() * names.length)];
    const duration = 2800;
    const start = performance.now();

    function animate(now: number) {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 4);
      const interval = 40 + eased * 340;

      if (elapsed < duration) {
        display.textContent = names[Math.floor(Math.random() * names.length)];
        animFrame = window.setTimeout(() => requestAnimationFrame(animate), interval);
      } else {
        display.textContent = winner;
        document.getElementById('draw-again-btn')!.style.display = '';
      }
    }
    requestAnimationFrame(animate);
  }

  drawBtn.addEventListener('click', runDraw);
  document.getElementById('draw-again-btn')!.addEventListener('click', runDraw);
  document.getElementById('close-modal-btn')!.addEventListener('click', () => {
    clearTimeout(animFrame);
    modal.hidden = true;
  });
  modal.addEventListener('click', (e) => {
    if (e.target === modal) { clearTimeout(animFrame); modal.hidden = true; }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden) { clearTimeout(animFrame); modal.hidden = true; }
  });

  function escHtml(s: string) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
</script>

<style is:global>
 /* Cards */
  .wishlist-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: clamp(16px, 2.5vw, 28px);
  }
  .wish-card {
    border: 1px solid var(--brass-faint);
    padding: clamp(16px, 2vw, 24px);
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: border-color 0.2s, opacity 0.2s;
  }
  .wish-card:hover { border-color: var(--brass-lo); }
  .wish-card--session { border-style: dashed; }

  /* Filtered by date — hide entirely */
  .wish-card[data-filtered="true"] { display: none; }

  /* Manually removed — dim and cross out name */
  .wish-card[data-removed="true"] {
    opacity: 0.28;
    pointer-events: none;
  }
  .wish-card[data-removed="true"] .wish-remove-btn {
    pointer-events: all;
  }
  .wish-card[data-removed="true"] .wish-name {
    text-decoration: line-through;
    text-decoration-color: var(--brass-faint);
  }

  .wish-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .wish-card-end {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .wish-rating {
    display: flex;
    align-items: center;
  }
  .wish-name {
    margin: 0;
    font-family: var(--serif-display);
    font-size: clamp(14px, 1.5vw, 18px);
    letter-spacing: 0.06em;
    color: var(--brass-hi);
    font-weight: 500;
    line-height: 1.2;
  }
  .wish-name-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--brass-faint);
    transition: border-color 0.15s;
  }
  .wish-name-link:hover { border-color: var(--brass-lo); }
  .wish-price {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--brass-lo);
    flex-shrink: 0;
  }
  .wish-session-badge {
    font-family: var(--serif-display);
    font-size: 8px;
    letter-spacing: 0.35em;
    color: var(--brass-faint);
    flex-shrink: 0;
  }
  .wish-meta {
    font-size: clamp(12px, 1.2vw, 14px);
    color: var(--brass-lo);
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
  }

  .wish-added { font-style: italic; }
  .wish-notes {
    margin: 4px 0 0;
    font-style: italic;
    font-size: clamp(13px, 1.25vw, 15px);
    color: #8a6f2e;
    line-height: 1.5;
  }

  /* Card footer with remove button */
  .wish-card-footer {
    margin-top: 8px;
    display: flex;
    justify-content: flex-end;
  }
  .wish-remove-btn {
    font-family: var(--serif-display);
    font-size: 8px;
    letter-spacing: 0.35em;
    padding: 4px 10px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--brass-faint);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .wish-remove-btn:hover {
    border-color: var(--brass-faint);
    color: var(--brass-lo);
  }
  .wish-card[data-removed="true"] .wish-remove-btn {
    color: var(--brass-lo);
    border-color: var(--brass-faint);
    opacity: 1;
  }
</style is:global>

<style>
  .wishlist-root { display: flex; flex-direction: column; gap: clamp(24px, 3.5vh, 40px); }

  /* Controls */
  .wishlist-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    padding-bottom: clamp(16px, 2.5vh, 28px);
    border-bottom: 1px solid var(--brass-faint);
  }

  .wishlist-controls.lot-draw {
    justify-content: center;
  }

  .draw-btn {
    font-family: var(--serif-display);
    font-size: clamp(9px, 0.95vw, 11px);
    letter-spacing: 0.45em;
    padding: 12px 28px 12px 32px;
    background: transparent;
    border: 1px solid var(--brass);
    color: var(--brass-hi);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .draw-btn:hover:not(:disabled) { background: rgba(201,167,103,0.08); }
  .draw-btn:disabled { opacity: 0.35; cursor: default; }

  /* Date filter */
  .date-filter {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .date-filter-label {
    font-family: var(--serif-display);
    font-size: clamp(8px, 0.85vw, 10px);
    letter-spacing: 0.35em;
    color: var(--brass-lo);
    white-space: nowrap;
  }
  .date-input {
    font-family: var(--serif-body);
    font-size: 14px;
    background: transparent;
    border: 1px solid var(--brass-faint);
    color: var(--brass-hi);
    padding: 6px 10px;
    outline: none;
    transition: border-color 0.15s;
    color-scheme: dark;
  }
  .date-input:focus { border-color: var(--brass-lo); }
  .filter-status {
    font-family: var(--serif-body);
    font-style: italic;
    font-size: clamp(11px, 1.1vw, 13px);
    color: var(--brass-lo);
    white-space: nowrap;
  }

  .add-form {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex: 1;
    min-width: 0;
  }
  .add-input {
    font-family: var(--serif-body);
    font-size: 15px;
    font-style: italic;
    background: transparent;
    border: 1px solid var(--brass-faint);
    color: var(--brass-hi);
    padding: 8px 12px;
    outline: none;
    flex: 1;
    min-width: 140px;
    transition: border-color 0.15s;
  }
  .add-input::placeholder { color: var(--brass-faint); }
  .add-input:focus { border-color: var(--brass-lo); }
  .add-input--sm { flex: 0.6; min-width: 110px; }

  .add-btn {
    font-family: var(--serif-display);
    font-size: clamp(9px, 0.9vw, 10px);
    letter-spacing: 0.4em;
    padding: 8px 18px 8px 22px;
    background: transparent;
    border: 1px solid var(--brass-faint);
    color: var(--brass-lo);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .add-btn:hover { border-color: var(--brass-lo); color: var(--brass-hi); }

 
  .sep { margin: 0 0.4em; color: var(--brass-faint); }

  /* Picker modal */
  .picker-modal {
    position: fixed;
    inset: 0;
    z-index: 10;
    background: rgba(6,24,18,0.88);
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(2px);
  }
  .picker-modal[hidden] { display: none; }

  .picker-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(20px, 3vh, 36px);
    padding: clamp(32px, 5vw, 72px);
    border: 1px solid var(--brass);
    background: var(--green);
    max-width: min(90vw, 560px);
    width: 100%;
    position: relative;
  }
  .picker-inner::before {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid var(--brass-faint);
    pointer-events: none;
  }

  .picker-eyebrow {
    font-family: var(--serif-display);
    font-size: clamp(9px, 0.95vw, 11px);
    letter-spacing: 0.5em;
    color: var(--brass-lo);
    padding-left: 0.5em;
  }
  .picker-display {
    font-family: var(--serif-display);
    font-size: clamp(22px, 4vw, 42px);
    letter-spacing: 0.06em;
    color: var(--brass-hi);
    font-weight: 500;
    text-align: center;
    min-height: 1.3em;
    line-height: 1.3;
  }

  .picker-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .picker-btn {
    font-family: var(--serif-display);
    font-size: clamp(9px, 0.9vw, 10px);
    letter-spacing: 0.4em;
    padding: 10px 24px 10px 28px;
    background: transparent;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .picker-btn--primary {
    border: 1px solid var(--brass-lo);
    color: var(--brass);
  }
  .picker-btn--primary:hover { border-color: var(--brass); color: var(--brass-hi); }
  .picker-btn--secondary {
    border: 1px solid var(--brass-faint);
    color: var(--brass-lo);
  }
  .picker-btn--secondary:hover { border-color: var(--brass-lo); color: var(--brass); }
</style>
