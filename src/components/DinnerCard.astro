---
interface Props {
  name: string;
  date: string;
  cuisine: string;
  neighborhood: string;
  price_range: number;
  rating: number;
  notes: string;
  website?: string;
}

const { name, date, cuisine, neighborhood, price_range, rating, notes, website } = Astro.props;

const fmtDate = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });

const diamonds = (filled: number, total = 4) =>
  '◆'.repeat(filled) + '◇'.repeat(total - filled);
---

<article class="dinner-card">
  <time class="dinner-date" datetime={date}>{fmtDate(date)}</time>
  <h2 class="dinner-name">
    {website ? <a href={website} target="_blank" rel="noopener" class="dinner-name-link">{name}</a> : name}
  </h2>
  <div class="dinner-meta">
    <span class="dinner-cuisine">{cuisine}</span>
    <span class="sep">·</span>
    <span class="dinner-neighborhood">{neighborhood}</span>
    <span class="sep">·</span>
    <span class="ratings">
      <span class="dinner-rating" title={`Rating: ${rating} of 5`}>★ {diamonds(rating, 5)}</span>
      <span class="sep">·</span>
      <span class="dinner-price" title={`Price range: ${price_range} of 4`}>$ {diamonds(price_range)}</span>
    </span>
  </div>

  {notes && <p class="dinner-notes">{notes}</p>}
</article>

<style>
  .dinner-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .dinner-date {
    font-family: var(--serif-display);
    font-size: clamp(9px, 0.95vw, 11px);
    letter-spacing: 0.38em;
    color: var(--brass-lo);
    text-transform: uppercase;
  }
  .dinner-name {
    margin: 0;
    font-family: var(--serif-display);
    font-weight: 500;
    font-size: clamp(22px, 3.2vw, 36px);
    letter-spacing: 0.06em;
    color: var(--brass-hi);
    line-height: 1.1;
  }
  .dinner-meta {
    font-family: var(--serif-body);
    font-size: clamp(14px, 1.4vw, 16px);
    color: var(--brass);
    letter-spacing: 0.04em;
  }
  .sep { margin: 0 0.5em; color: var(--brass-faint); }

  @media (max-width: 480px) {
    .ratings { display: block; }
  }

  .dinner-price { letter-spacing: 0.1em; }
  .dinner-rating {
    font-size: clamp(13px, 1.3vw, 15px);
    color: var(--brass);
    letter-spacing: 0.15em;
  }
  .dinner-name-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--brass-faint);
    transition: border-color 0.15s;
  }
  .dinner-name-link:hover { border-color: var(--brass-lo); }
  .dinner-notes {
    margin: 4px 0 0;
    font-style: italic;
    font-size: clamp(15px, 1.55vw, 18px);
    color: #b8975a;
    max-width: 68ch;
    line-height: 1.5;
  }
</style>
