---
interface Props {
  date: string;
}
const { date } = Astro.props;
---

<div class="countdown" data-target={date} data-state="counting">
  <div class="cd-ticker">
    <div class="cd-unit">
      <span class="cd-value" id="cd-days">––</span>
      <span class="cd-label">DAYS</span>
    </div>
    <span class="cd-sep">·</span>
    <div class="cd-unit">
      <span class="cd-value" id="cd-hours">––</span>
      <span class="cd-label">HRS</span>
    </div>
    <span class="cd-sep">·</span>
    <div class="cd-unit">
      <span class="cd-value" id="cd-mins">––</span>
      <span class="cd-label">MIN</span>
    </div>
    <span class="cd-sep">·</span>
    <div class="cd-unit">
      <span class="cd-value" id="cd-secs">––</span>
      <span class="cd-label">SEC</span>
    </div>
  </div>
  <div class="cd-now">HAPPENING NOW</div>
  <div class="cd-soon">
    <span class="cd-message-line">THE GATHERING HAS PASSED</span>
    <span class="cd-message-sub">A new one is coming soon</span>
  </div>
</div>

<script>
  const el = document.querySelector<HTMLElement>('.countdown');
  if (el) {
    const target = new Date(el.dataset.target!).getTime();
    const HAPPENING_NOW_MS = 3 * 60 * 60 * 1000;

    function pad(n: number) { return String(n).padStart(2, '0'); }

    function tick() {
      const diff = target - Date.now();

      if (diff > 0) {
        el.dataset.state = 'counting';
        const days  = Math.floor(diff / 86400000);
        const hours = Math.floor((diff % 86400000) / 3600000);
        const mins  = Math.floor((diff % 3600000) / 60000);
        const secs  = Math.floor((diff % 60000) / 1000);
        document.getElementById('cd-days')!.textContent  = String(days);
        document.getElementById('cd-hours')!.textContent = pad(hours);
        document.getElementById('cd-mins')!.textContent  = pad(mins);
        document.getElementById('cd-secs')!.textContent  = pad(secs);
      } else if (-diff < HAPPENING_NOW_MS) {
        el.dataset.state = 'now';
      } else {
        el.dataset.state = 'soon';
      }
    }

    tick();
    setInterval(tick, 1000);
  }
</script>

<style>
  .countdown {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 36px);
    flex-wrap: wrap;
    justify-content: center;
  }

  /* State-driven visibility — CSS owns this, not JS hidden attribute */
  .countdown:not([data-state="counting"]) .cd-ticker,
  .countdown:not([data-state="now"])      .cd-now,
  .countdown:not([data-state="soon"])     .cd-soon {
    display: none;
  }

  /* Ticker layout */
  .cd-ticker {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 36px);
    flex-wrap: wrap;
    justify-content: center;
  }
  .cd-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .cd-value {
    font-family: var(--serif-display);
    font-size: clamp(38px, 8vw, 80px);
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--brass-hi);
    line-height: 1;
    min-width: 2ch;
    text-align: center;
  }
  .cd-label {
    font-family: var(--serif-display);
    font-size: clamp(8px, 0.85vw, 10px);
    letter-spacing: 0.5em;
    color: var(--brass-lo);
    padding-left: 0.5em;
  }
  .cd-sep {
    font-family: var(--serif-display);
    font-size: clamp(24px, 4vw, 48px);
    color: var(--brass-faint);
    align-self: flex-start;
    margin-top: 0.15em;
  }

  /* Post-event messages */
  .cd-now {
    font-family: var(--serif-display);
    font-size: clamp(22px, 4.5vw, 52px);
    font-weight: 400;
    letter-spacing: 0.15em;
    color: var(--brass-hi);
    text-align: center;
    padding-left: 0.15em;
  }
  .cd-soon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .cd-message-line {
    font-family: var(--serif-display);
    font-size: clamp(14px, 2.5vw, 26px);
    letter-spacing: 0.2em;
    color: var(--brass-lo);
    text-align: center;
    padding-left: 0.2em;
  }
  .cd-message-sub {
    font-family: var(--serif-body);
    font-style: italic;
    font-size: clamp(15px, 1.8vw, 20px);
    letter-spacing: 0.04em;
    color: var(--brass-faint);
  }
</style>
